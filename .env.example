APP_SECRET_KEY=replace-with-a-local-development-secret-at-least-32-characters
ADMIN_USERNAME=admin
# Generate with: uv run python -m app.cli hash-password
# Wrap the resulting Argon2id hash in single quotes because it contains `$`.
ADMIN_PASSWORD_HASH=
# Generate with: uv run python -m app.cli generate-admin-path
ADMIN_PATH=/control-local-development
# This relative path is for the local uv workflow. The database file is created in this directory.
DATABASE_URL=sqlite:///./keyport.db
BASE_URL=http://localhost:8000
ENVIRONMENT=development
# Use the hostname or IP address only, without http://, https://, a path, or a port.
TRUSTED_HOSTS=localhost,127.0.0.1
# Used only by the Docker/Caddy production deployment. Use .env.production.example for production.
CADDY_DOMAIN=localhost
