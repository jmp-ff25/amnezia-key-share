APP_SECRET_KEY=replace-with-at-least-32-random-bytes
ADMIN_USERNAME=admin
# Generate with: uv run python -m app.cli hash-password
# Wrap the resulting Argon2id hash in single quotes because it contains `$`.
ADMIN_PASSWORD_HASH=
# Generate with: uv run python -m app.cli generate-admin-path
ADMIN_PATH=/control-replace-with-a-random-value
# This path exists inside the Docker app container. Do not use it with a local uv command.
DATABASE_URL=sqlite:////data/keyport.db
# Set all three address settings below to one public domain name or static public IP address.
# If no domain is available, use the VPS public IPv4 address, for example 203.0.113.10.
# BASE_URL includes https://; TRUSTED_HOSTS and CADDY_DOMAIN must not include a scheme, path, or port.
BASE_URL=https://keys.example.com
ENVIRONMENT=production
TRUSTED_HOSTS=keys.example.com
CADDY_DOMAIN=keys.example.com
